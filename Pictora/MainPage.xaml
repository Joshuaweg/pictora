                />
            
            <Label 
                Text="112358132134"
                Style="{StaticResource Headline}"    
            />
            
            <Button
                x:Name="ImageEditBtn"
                Text="Go to Image Editor" 
                SemanticProperties.Hint="Navigate to the Image Edit Page"
                Clicked="OnImageEditClicked"
                HorizontalOptions="Fill" />
            
            <Button
                x:Name="ImageGenerateBtn"
                Text="Go to Image Generator" 
                SemanticProperties.Hint="Navigate to the Image Edit Page"
                Clicked="OnImageGeneratedClicked"
                HorizontalOptions="Fill" />
            -->
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
