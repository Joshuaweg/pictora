<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pictora.MainPage"
             BackgroundColor="#0d0d3c"> <!-- Dark background -->

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="CenterAndExpand"
            HorizontalOptions="CenterAndExpand">
            
            <!-- Logo Section -->
            <Image
                Source="pictoralogo.png"
                HeightRequest="150"
                WidthRequest="150"
                Aspect="AspectFit"
                HorizontalOptions="Center">
                <Image.Clip> 
                    <EllipseGeometry Center="75,75" RadiusX="75" RadiusY="75" /> <!-- Makes Pictora Logo Circular -->
                </Image.Clip>
            </Image>

            <!-- Greeting Section -->
            <Label Text="Welcome to Pictora"
                   FontSize="28"
                   TextColor="#ECECEC" 
                   HorizontalOptions="Center"
                   Margin="0,10,0,10"/>

            <!-- Navigation Buttons -->
            <Button x:Name="LoginBtn"
                    Text="Login"
                    BackgroundColor="#2196F3" 
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="8"
                    HeightRequest="45"
                    WidthRequest="200"
                    HorizontalOptions="Center"
                    Margin="0,5,0,5"
                    Clicked="OnLoginClicked" />

            <Button x:Name="SignUpBtn"
                    Text="Sign Up"
                    BackgroundColor="#FF8C00" 
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="8"
                    HeightRequest="45"
                    WidthRequest="200"
                    HorizontalOptions="Center"
                    Margin="0,5,0,5"
                    Clicked="OnSignUpClicked" />


            <Button x:Name="ImageEditBtn"
                    Text="Image Editor"
                    BackgroundColor="#FF6347" 
                    FontSize="18"
                    CornerRadius="8"
                    HeightRequest="45"
                    WidthRequest="200"
                    HorizontalOptions="Center"
                    Margin="0,5,0,5"
                    Clicked="OnImageEditClicked"/>

            <Button x:Name="ImageGenerateBtn"
                    Text="Image Generator"
                    BackgroundColor="#8A2BE2" 
                    FontSize="18"
                    CornerRadius="8"
                    HeightRequest="45"
                    WidthRequest="200"
                    HorizontalOptions="Center"
                    Margin="0,5,0,5"
                    Clicked="OnImageGeneratedClicked" />

            <!-- Change this button to a different color -->
            <Button x:Name="ImageGalleryBtn"
        Text="Image Gallery"
        BackgroundColor="#009999" 
        FontSize="18"
        CornerRadius="8"
        HeightRequest="45"
        WidthRequest="200"
        HorizontalOptions="Center"
        Margin="0,5,0,5"
        Clicked="OnImageGalleryClicked" />
            <!-- Below is old code; not sure if it was okay to delete
            <Label
                Text="Hello, World!"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Welcome to &#10;.NET Multi-platform App UI"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Welcome to dot net Multi platform App UI" /> 
            <Button
                x:Name="LoginBtn"
                Text="Login" 
                SemanticProperties.Hint="Navigate to login page"
                Clicked="OnLoginClicked"
                HorizontalOptions="Fill" /> 
            
            <Button
                x:Name="CounterBtn"
                Text="Click me" 
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" /> 
            
            <ImageButton 
                x:Name="Doubler"
                BackgroundColor="LightBlue"
                CornerRadius="80"
                AbsoluteLayout.LayoutFlags="PositionProportional"  
                AbsoluteLayout.LayoutBounds=".95,.95,80,80"
                Clicked ="OnCounterDouble"
                />
            
            <Label 
                Text="112358132134"
                Style="{StaticResource Headline}"    
            />
            
            <Button
                x:Name="ImageEditBtn"
                Text="Go to Image Editor" 
                SemanticProperties.Hint="Navigate to the Image Edit Page"
                Clicked="OnImageEditClicked"
                HorizontalOptions="Fill" />
            
            <Button
                x:Name="ImageGenerateBtn"
                Text="Go to Image Generator" 
                SemanticProperties.Hint="Navigate to the Image Edit Page"
                Clicked="OnImageGeneratedClicked"
                HorizontalOptions="Fill" />
            -->
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
