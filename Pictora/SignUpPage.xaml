<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pictora.SignUpPage"
             Title="Sign Up">
    <Grid>
        <!-- Background Image -->
        <Image Source="background.png"
               Aspect="AspectFill"
               IsOpaque="True"
               Opacity="0.9"
               VerticalOptions="FillAndExpand"
               HorizontalOptions="FillAndExpand" />

        <ScrollView>
            <VerticalStackLayout
                Padding="0,20,0,20"
                Spacing="15"
                VerticalOptions="CenterAndExpand"
                HorizontalOptions="CenterAndExpand">

                <!-- Logo Section -->
                <Image
                    Source="pictoralogo.png"
                    HeightRequest="150"
                    WidthRequest="150"  
                    Aspect="AspectFit"
                    HorizontalOptions="Center">
                    <Image.Clip>
                        <EllipseGeometry Center="75,75" RadiusX="75" RadiusY="75" />
                    </Image.Clip>
                </Image>

                <!-- Page Title -->
                <Label Text="Create Your Account"
                       FontFamily="OpenSans-Bold"
                       FontSize="26"
                       TextColor="#FFFFFF"
                       HorizontalOptions="Center"
                       Margin="0,10,0,10">
                       <Label.Shadow>
                           <Shadow Brush="#000000" Opacity="0.3" Radius="3" Offset="2,2" />
                           <!-- Subtle shadow -->
                       </Label.Shadow>
                </Label>

                <!-- Email Entry -->
                <Frame
                    BackgroundColor="#1A1A3C"
                    BorderColor="#FF8C00"
                    CornerRadius="22"
                    Padding="0"
                    HasShadow="True"
                    Margin="0,5,0,5"
                    WidthRequest="250"
                    HeightRequest="50"
                    HorizontalOptions="Center">
                    <Entry
                        x:Name="EmailEntr"
                        Placeholder="Email"
                        PlaceholderColor="#B0B0C3"
                        FontSize="16"
                        FontFamily="Nunito-Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        HorizontalTextAlignment="Center" />
                </Frame>

                <!-- Username Entry -->
                <Frame
                    BackgroundColor="#1A1A3C"
                    BorderColor="#FF8C00"
                    CornerRadius="22"
                    Padding="0"
                    HasShadow="True"
                    Margin="0,5,0,5"
                    WidthRequest="250"
                    HeightRequest="50"
                    HorizontalOptions="Center">
                    <Entry
                        x:Name="UsernameEntr"
                        Placeholder="Username"
                        PlaceholderColor="#B0B0C3"
                        FontSize="16"
                        FontFamily="Nunito-Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        HorizontalTextAlignment="Center" />
                </Frame>

                <!-- Password Entry -->
                <Frame
                    BackgroundColor="#1A1A3C"
                    BorderColor="#FF8C00"
                    CornerRadius="22"
                    Padding="0"
                    HasShadow="True"
                    Margin="0,5,0,5"
                    WidthRequest="250"
                    HeightRequest="50"
                    HorizontalOptions="Center">
                    <Entry
                        x:Name="PasswordEntr"
                        Placeholder="Password"
                        IsPassword="True"
                        PlaceholderColor="#B0B0C3"
                        FontSize="16"
                        FontFamily="Nunito-Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        HorizontalTextAlignment="Center" />
                </Frame>

                <!-- Confirm Password Entry -->
                <Frame
                    BackgroundColor="#1A1A3C"
                    BorderColor="#FF8C00"
                    CornerRadius="22"
                    Padding="0"
                    HasShadow="True"
                    Margin="0,5,0,5"
                    WidthRequest="250"
                    HeightRequest="50"
                    HorizontalOptions="Center">
                    <Entry
                        x:Name="ConfirmPasswordEntr"
                        Placeholder="Confirm Password"
                        IsPassword="True"
                        PlaceholderColor="#B0B0C3"
                        FontSize="16"
                        FontFamily="Nunito-Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        HorizontalTextAlignment="Center" />
                </Frame>

                <!-- Sign Up Button -->
                <Button
                    x:Name="SignUpButton"
                    Text="Sign Up"
                    BackgroundColor="#FF8C00"
                    TextColor="White"
                    FontFamily="Nunito-Bold"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="22"
                    HeightRequest="50"
                    WidthRequest="250"
                    HorizontalOptions="Center"
                    Clicked="OnSignUpClicked"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.3" Radius="6" Offset="2,2" />
                    </Button.Shadow>
                </Button>

                <!-- Error or Success Message -->
                <Label
                    x:Name="MessageLabell"
                    Text=""
                    TextColor="Red"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
