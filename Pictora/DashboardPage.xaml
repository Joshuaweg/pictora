<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pictora.DashboardPage">
    <Grid>
        <Image Source="background.png"
               Aspect="AspectFill"
               IsOpaque="True"
               Opacity="0.9"
               VerticalOptions="FillAndExpand"
               HorizontalOptions="FillAndExpand" />

        <ScrollView>
            <VerticalStackLayout
                Padding="0,20,0,20"
                Spacing="15"
                VerticalOptions="CenterAndExpand"
                HorizontalOptions="CenterAndExpand">

                <Image
                    Source="pictoralogo.png"
                    HeightRequest="150"
                    WidthRequest="150"
                    Aspect="AspectFit"
                    HorizontalOptions="Center">
                    <Image.Clip>
                        <EllipseGeometry Center="75,75" RadiusX="75" RadiusY="75" />
                    </Image.Clip>
                </Image>

                <Label Text="Pictora Dashboard"
                    FontSize="32"
                    FontFamily="OpenSans-Bold"
                    TextColor="#FFFFFF"
                    HorizontalOptions="Center"
                    Margin="0,10,0,30">
                    <Label.Shadow>
                        <Shadow Brush="#000000" Opacity="0.3" Radius="3" Offset="2,2" />
                    </Label.Shadow>
                </Label>

                <Button x:Name="ImageEditBtn"
                        Text="Image Editor"
                        BackgroundColor="#FF6347"
                        FontFamily="Nunito-Bold"
                        FontSize="18"
                        FontAttributes="Bold"
                        CornerRadius="22"
                        HeightRequest="50"
                        WidthRequest="220"
                        HorizontalOptions="Center"
                        Margin="0,8,0,8"
                        Clicked="OnImageEditClicked"
                        Pressed="OnButtonPressed"
                        Released="OnButtonReleased">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.5" Radius="12" Offset="4,4" />
                    </Button.Shadow>
                </Button>

                <Button x:Name="ImageGenerateBtn"
                        Text="Image Generator"
                        BackgroundColor="#8A2BE2"
                        FontFamily="Nunito-Bold"
                        FontSize="18"
                        FontAttributes="Bold"
                        CornerRadius="22"
                        HeightRequest="50"
                        WidthRequest="220"
                        HorizontalOptions="Center"
                        Margin="0,8,0,8"
                        Clicked="OnImageGeneratedClicked"
                        Pressed="OnButtonPressed"
                        Released="OnButtonReleased">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.5" Radius="12" Offset="4,4" />
                    </Button.Shadow>
                </Button>

                <Button x:Name="ImageGalleryBtn"
                        Text="Image Gallery"
                        BackgroundColor="#008080"
                        FontFamily="Nunito-Bold"
                        FontSize="18"
                        FontAttributes="Bold"
                        CornerRadius="22"
                        HeightRequest="50"
                        WidthRequest="220"
                        HorizontalOptions="Center"
                        Margin="0,8,0,8"
                        Clicked="OnImageGalleryClicked"
                        Pressed="OnButtonPressed"
                        Released="OnButtonReleased">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.5" Radius="12" Offset="4,4" />
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>