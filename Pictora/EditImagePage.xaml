<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pictora.EditImagePage"
             Title="Image Editor"
             BackgroundImageSource="background.png">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">

        <!-- Top Buttons -->
        <Grid ColumnDefinitions="*,*,*" VerticalOptions="Start" Margin="10" Grid.Row="0">
            <Button x:Name="InpaintButton"
                    Text="Inpainting" 
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    FontFamily="Nunito-Bold"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="22"
                    HeightRequest="50"
                    Grid.Column="0"
                    Margin="5"
                    Clicked="OnInpaintButtonClicked">
                <Button.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Radius="6" Offset="3,3" />
                </Button.Shadow>
            </Button>

            <Button x:Name="AddCaptionButton"
                    Text="Add Captions"
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    FontFamily="Nunito-Bold"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="22"
                    HeightRequest="50"
                    Clicked="OnAddCaptionClicked"
                    Grid.Column="1"
                    Margin="5">
                <Button.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Radius="6" Offset="3,3" />
                </Button.Shadow>
            </Button>

            <Button Text="Draw Shapes"
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    FontFamily="Nunito-Bold"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="22"
                    HeightRequest="50"
                    Grid.Column="2"
                    Margin="5">
                <Button.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Radius="6" Offset="3,3" />
                </Button.Shadow>
            </Button>
        </Grid>
        <!-- Main Image Container -->
        <Grid Grid.Row="1" 
              x:Name="MainContainer"
              Margin="10">

            <!-- Base Image Content -->
            <Grid x:Name="ImageContainer"
          WidthRequest="300"
          HeightRequest="300"
          BackgroundColor="Transparent"
          HorizontalOptions="Center">
                <Image x:Name="EditableImage" 
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"/>
                <Grid x:Name="CaptionOverlay" 
              IsVisible="False"
              InputTransparent="False"
              BackgroundColor="Transparent"/>
                <ActivityIndicator x:Name="LoadingIndicator" 
                          IsVisible="False"
                          IsRunning="False"
                          HorizontalOptions="Center" 
                          VerticalOptions="Center"/>
            </Grid>

            <!-- Inpainting Overlay -->
            <!-- Replace the existing InpaintingCanvas Grid with this updated version -->
            <Grid x:Name="InpaintingCanvas" 
     IsVisible="False"
          BackgroundColor="Transparent"
          InputTransparent="False"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">

                    <!-- Add margin for buttons -->
                    <Grid x:Name="InpaintContainer"
              HorizontalOptions="Center"
              VerticalOptions="Center">
                        <Image x:Name="DarkenedImage"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Opacity="0.6"/>
                    <GraphicsView x:Name="MaskCanvas"
             HorizontalOptions="Fill"
             VerticalOptions="Fill"
             Background="Transparent" />

                </Grid>
               

                <StackLayout Orientation="Horizontal" 
                 HorizontalOptions="Center"
                 VerticalOptions="End"
                 Spacing="10"
                 Margin="0,0,0,10"
                 ZIndex="1">
                    <Button x:Name="UndoButton"
                Text="Undo"
                BackgroundColor="#FF6347"
                TextColor="White"
                CornerRadius="8"
                Clicked="OnUndoButtonClicked"/>
                    <Button x:Name="ClearButton"
                Text="Clear"
                BackgroundColor="#FF6347"
                TextColor="White"
                CornerRadius="8"
                Clicked="OnClearButtonClicked"/>
                    <Button x:Name="ApplyButton"
                Text="Apply Inpainting"
                BackgroundColor="#FF6347"
                TextColor="White"
                CornerRadius="8"
                 Clicked="OnApplyInpaintingClicked"/>
                </StackLayout>
            </Grid>
        </Grid>

        <!-- Rest of your existing content remains the same -->
        <!-- Caption Editor Panel -->
        <Grid x:Name="CaptionEditorPanel" 
              Grid.Row="2" 
              IsVisible="False"
              RowDefinitions="Auto,Auto"
              Margin="10"
              BackgroundColor="#1A1A3C"
              Padding="15"
             >
            <Frame BackgroundColor="#1A1A3C"
                   BorderColor="#FF6347"
                   CornerRadius="22"
                   Padding="10"
                   HasShadow="True"
                   Margin="0,0,0,10">
                <Entry x:Name="CaptionTextEntry" 
                       Placeholder="Enter caption text"
                       PlaceholderColor="#FFFFFF"
                       TextColor="White"
                       FontFamily="Nunito-Bold"
                       FontSize="16"
                       HorizontalTextAlignment="Center"/>
            </Frame>

            <StackLayout Orientation="Horizontal" 
                        Grid.Row="1" 
                        Spacing="10"
                        HorizontalOptions="Center">
                <Button x:Name="AddTextButton" 
                        Text="Add Text" 
                        BackgroundColor="#FF6347"
                        TextColor="White"
                        FontFamily="Nunito-Bold"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="22"
                        HeightRequest="50"
                        WidthRequest="120"
                        Clicked="OnAddTextButtonClicked">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.2" Radius="6" Offset="3,3" />
                    </Button.Shadow>
                </Button>

                <Button x:Name="DoneCaptioningButton" 
                        Text="Done" 
                        BackgroundColor="#FF6347"
                        TextColor="White"
                        FontFamily="Nunito-Bold"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="22"
                        HeightRequest="50"
                        WidthRequest="120"
                        Clicked="OnDoneCaptioningClicked">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.2" Radius="6" Offset="3,3" />
                    </Button.Shadow>
                </Button>
            </StackLayout>
        </Grid>

        <!-- Prompt Editor -->
        
        <Border Grid.Row="3"
                Margin="10"
                BackgroundColor="#1A1A3C"
                
                StrokeShape="RoundRectangle 22,22,22,22"
                 Stroke="#FF6347"
                StrokeThickness="1">
            <Editor x:Name="PromptEditor" 
                    Placeholder="Enter prompt to edit image" 
                    PlaceholderColor="#FFFFFF"
                    TextColor="White"
                    FontFamily="Nunito-Bold"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    AutoSize="TextChanges" 
                    MaxLength="500"/>
        </Border>

        <!-- Edit Button -->
        <Button x:Name="EditButton" 
                Grid.Row="4" 
                Text="Edit"
                BackgroundColor="#FF6347"
                TextColor="White"
                FontFamily="Nunito-Bold"
                FontSize="18"
                FontAttributes="Bold"
                CornerRadius="22"
                HeightRequest="50"
                WidthRequest="500"
                HorizontalOptions="Center"
                Margin="10">
            <Button.Shadow>
                <Shadow Brush="Black" Opacity="0.2" Radius="6" Offset="3,3" />
            </Button.Shadow>
        </Button>

        <!-- Filter Buttons -->
        <Grid Grid.Row="5" x:Name="FilterContainer" HorizontalOptions="Center">
            <!-- Base Container -->
            <Frame BackgroundColor="White"
           CornerRadius="25"
           Padding="2"
           HasShadow="False"
           BorderColor="#8B5CF6"
           HeightRequest="50"
           WidthRequest="300"
           HorizontalOptions="Center"
           ZIndex="0">
            </Frame>

            <!-- Selection Indicator -->
            <Frame x:Name="SelectionIndicator"
           BackgroundColor="#FF6347"
           CornerRadius="23"
           HasShadow="False"
           IsClippedToBounds="True"
           HorizontalOptions="Start"
           WidthRequest="100"
           HeightRequest="46"
           Margin="2,2,2,2"
           ZIndex="1"/>

            <!-- Filter Buttons Grid -->
            <Grid ColumnDefinitions="100,100,100" 
          ColumnSpacing="0"
          ZIndex="2">
                <Frame x:Name="BlackAndWhiteFrame"
               Grid.Column="0" 
               BackgroundColor="Transparent"
               Padding="0"
               CornerRadius="23"
               HasShadow="False"
               BorderColor="Transparent"
               WidthRequest="100">
                    <Label x:Name="BlackAndWhiteLabel"
                   Text="Black and White"
                   TextColor="#666666"
                   FontFamily="Nunito-Bold"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBlackAndWhiteTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Frame>

                <Frame x:Name="BlueShiftFrame"
               Grid.Column="1"
               BackgroundColor="Transparent"
               Padding="0"
               CornerRadius="23"
               HasShadow="False"
               BorderColor="Transparent"
               WidthRequest="100">
                    <Label x:Name="BlueShiftLabel"
                   Text="Blue Shift"
                   TextColor="#666666"
                   FontFamily="Nunito-Bold"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBlueShiftTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Frame>

                <Frame x:Name="VintageFrame"
               Grid.Column="2"
               BackgroundColor="Transparent"
               Padding="0"
               CornerRadius="23"
               HasShadow="False"
               BorderColor="Transparent"
               WidthRequest="100">
                    <Label x:Name="VintageLabel"
                   Text="Vintage"
                   TextColor="#666666"
                   FontFamily="Nunito-Bold"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVintageTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Frame>
            </Grid>
        </Grid>

        <!-- Save Button -->
        <VerticalStackLayout Grid.Row="6"
                          Spacing="10"
                          Margin="10">
            <Button x:Name="SaveButton" 
                    Text="Save" 
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    FontFamily="Nunito-Bold"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="22"
                    HeightRequest="50"
                    WidthRequest="500"
                    HorizontalOptions="Center">
                <Button.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Radius="6" Offset="3,3" />
                </Button.Shadow>
            </Button>

            <Button x:Name="UploadButton" 
                    Text="Upload" 
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    FontFamily="Nunito-Bold"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="22"
                    HeightRequest="50"
                    WidthRequest="500"
                    HorizontalOptions="Center">
                <Button.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Radius="6" Offset="3,3" />
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>
    </Grid>
</ContentPage>