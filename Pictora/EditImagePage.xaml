<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pictora.EditImagePage"
             Title="Image Editor"
             BackgroundColor="#0d0d3c">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
        <!-- Top Buttons -->
        <Grid ColumnDefinitions="*,*,*" VerticalOptions="Start" Margin="10" Grid.Row="0">
            <Button x:Name="InpaintButton"
                    Text="Inpainting" 
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    CornerRadius="10"
                    Grid.Column="0"
                    Clicked="OnInpaintButtonClicked"/>
            <Button x:Name="AddCaptionButton"
                    Text="Add Captions"
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="OnAddCaptionClicked"
                    Grid.Column="1"/>
            <Button Text="Draw Shapes"
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    CornerRadius="10"
                    Grid.Column="2"/>
        </Grid>

        <!-- Main Image Container -->
        <Grid Grid.Row="1" 
              x:Name="MainContainer"
              Margin="10">

            <!-- Base Image Content -->
            <Grid x:Name="ImageContainer"
          WidthRequest="300"
          HeightRequest="300"
          BackgroundColor="Transparent"
          HorizontalOptions="Center">
                <Image x:Name="EditableImage" 
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"/>
                <Grid x:Name="CaptionOverlay" 
              IsVisible="False"
              InputTransparent="False"
              BackgroundColor="Transparent"/>
                <ActivityIndicator x:Name="LoadingIndicator" 
                          IsVisible="False"
                          IsRunning="False"
                          HorizontalOptions="Center" 
                          VerticalOptions="Center"/>
            </Grid>

            <!-- Inpainting Overlay -->
            <!-- Replace the existing InpaintingCanvas Grid with this updated version -->
            <Grid x:Name="InpaintingCanvas" 
     IsVisible="False"
          BackgroundColor="Transparent"
          InputTransparent="False"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">

                    <!-- Add margin for buttons -->
                    <Grid x:Name="InpaintContainer"
              HorizontalOptions="Center"
              VerticalOptions="Center">
                        <Image x:Name="DarkenedImage"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Opacity="0.6"/>
                    <GraphicsView x:Name="MaskCanvas"
             HorizontalOptions="Fill"
             VerticalOptions="Fill"
             Background="Transparent" />

                </Grid>
               

                <StackLayout Orientation="Horizontal" 
                 HorizontalOptions="Center"
                 VerticalOptions="End"
                 Spacing="10"
                 Margin="0,0,0,10"
                 ZIndex="1">
                    <Button x:Name="UndoButton"
                Text="Undo"
                BackgroundColor="#FF6347"
                TextColor="White"
                CornerRadius="8"
                Clicked="OnUndoButtonClicked"/>
                    <Button x:Name="ClearButton"
                Text="Clear"
                BackgroundColor="#FF6347"
                TextColor="White"
                CornerRadius="8"
                Clicked="OnClearButtonClicked"/>
                    <Button x:Name="ApplyButton"
                Text="Apply Inpainting"
                BackgroundColor="#FF6347"
                TextColor="White"
                CornerRadius="8"
                 Clicked="OnApplyInpaintingClicked"/>
                </StackLayout>
            </Grid>
        </Grid>

        <!-- Rest of your existing content remains the same -->
        <!-- Caption Editor Panel -->
        <Grid x:Name="CaptionEditorPanel" 
              Grid.Row="2" 
              IsVisible="False"
              RowDefinitions="Auto,Auto"
              Margin="10"
              BackgroundColor="#1a1a4d"
              Padding="10">
            <Entry x:Name="CaptionTextEntry" 
                   Placeholder="Enter caption text"
                   PlaceholderColor="Gray"
                   TextColor="White"
                   Grid.Row="0"
                   Margin="0,0,0,10"/>
            <StackLayout Orientation="Horizontal" 
                        Grid.Row="1" 
                        Spacing="10"
                        HorizontalOptions="Center">
                <Button x:Name="AddTextButton" 
                        Text="Add Text" 
                        BackgroundColor="#FF6347"
                        TextColor="White"
                        CornerRadius="8"
                        Clicked="OnAddTextButtonClicked"/>
                <Button x:Name="DoneCaptioningButton" 
                        Text="Done" 
                        BackgroundColor="#FF6347"
                        TextColor="White"
                        CornerRadius="8"
                        Clicked="OnDoneCaptioningClicked"/>
            </StackLayout>
        </Grid>

        <!-- Prompt Editor -->
        <Editor x:Name="PromptEditor" 
                Grid.Row="3" 
                Placeholder="Enter prompt to edit image" 
                PlaceholderColor="Gray"
                TextColor="White"
                BackgroundColor="#1a1a4d"
                AutoSize="TextChanges" 
                MaxLength="500"
                Margin="10"/>

        <!-- Edit Button -->
        <Button x:Name="EditButton" 
                Grid.Row="4" 
                Text="Edit"
                BackgroundColor="#FF6347"
                TextColor="White"
                CornerRadius="8"
                Margin="10"/>

        <!-- Filter Buttons -->
        <StackLayout Grid.Row="5" 
                     Orientation="Horizontal" 
                     HorizontalOptions="Center"
                     Spacing="10"
                     Margin="0,10">
            <Button x:Name="Filter1Button" 
                    Text="Filter 1"
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    CornerRadius="8"/>
            <Button x:Name="Filter2Button" 
                    Text="Filter 2"
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    CornerRadius="8"/>
            <Button x:Name="Filter3Button"
                    Text="Filter 3"
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    CornerRadius="8"/>
        </StackLayout>

        <!-- Save Button -->
        <Button x:Name="SaveButton" 
                Grid.Row="6" 
                Text="Save" 
                BackgroundColor="#FF6347"
                TextColor="White"
                CornerRadius="8"
                Margin="10"/>
    </Grid>
</ContentPage>