<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pictora.EditImagePage"
             Title="Image Editor"
             BackgroundImageSource="background.png">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
        
        
        <!-- Top Buttons -->
        <Grid ColumnDefinitions="*,*,*" VerticalOptions="Start" Margin="10" Grid.Row="0">
            <Button x:Name="InpaintButton"
                    Text="Inpainting" 
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    ImageSource="inpainting_icon.png" 
                    ContentLayout="Left,5"
                    FontFamily="Nunito-Bold"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    Grid.Column="0"
                    Margin="5"
                    Clicked="OnInpaintButtonClicked"/>
            <Button x:Name="AddCaptionButton"
                    Text="Add Captions"
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    ImageSource="captions_icon.png" 
                    ContentLayout="Left,5"
                    FontFamily="Nunito-Bold"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    Clicked="OnAddCaptionClicked"
                    Grid.Column="1"
                    Margin="5"/>
            <Button Text="Draw Shapes"
                    BackgroundColor="#FF6347"
                    TextColor="White"
                    ImageSource="shapes_icon.png" 
                    ContentLayout="Left,5"
                    FontFamily="Nunito-Bold"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    Grid.Column="2"
                    Margin="5"
                    Clicked="OnDrawShapesButtonClicked"/>
        </Grid>

        <!-- Main Image Container -->
        <Grid Grid.Row="1" 
              x:Name="MainContainer"
              Margin="10">

            <!-- Base Image Content -->
            <Grid x:Name="ImageContainer"
          BackgroundColor="Black"
          HeightRequest="300"
          WidthRequest="300"
          Padding="0"
          Margin="0">
                <Image x:Name="EditableImage" 
           Aspect="AspectFit"
           HorizontalOptions="FillAndExpand"
           VerticalOptions="FillAndExpand"
           Margin="0" />
                <GraphicsView x:Name="ShapeCanvas" 
              StartInteraction="OnStartDrawingShape"
              DragInteraction="OnDraggingShape"
              EndInteraction="OnEndDrawingShape"
              InputTransparent="True"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              Background="Transparent"
              ZIndex="1" />
                <Grid x:Name="CaptionOverlay"
          InputTransparent="False"
          HorizontalOptions="FillAndExpand"
          VerticalOptions="FillAndExpand"
          Margin="0" />
                <ActivityIndicator x:Name="LoadingIndicator" 
                          IsVisible="False"
                          IsRunning="False"
                          HorizontalOptions="Center" 
                          VerticalOptions="Center"/>
            </Grid>

            <!-- Inpainting Overlay -->
            <!-- Replace the existing InpaintingCanvas Grid with this updated version -->
            <Grid x:Name="InpaintingCanvas" 
     IsVisible="False"
          BackgroundColor="Transparent"
          InputTransparent="False"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">

                    <!-- Add margin for buttons -->
                    <Grid x:Name="InpaintContainer"
              HorizontalOptions="Center"
              VerticalOptions="Center">
                        <Image x:Name="DarkenedImage"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Opacity="0.6"/>
                    <GraphicsView x:Name="MaskCanvas"
             HorizontalOptions="Fill"
             VerticalOptions="Fill"
             Background="Transparent" />

                </Grid>
               

                <StackLayout Orientation="Horizontal" 
                 HorizontalOptions="Center"
                 VerticalOptions="End"
                 Spacing="10"
                 Margin="0,0,0,10"
                 ZIndex="1">
                    <Button x:Name="UndoButton"
                Text="Undo"
                BackgroundColor="#FF6347"
                TextColor="White"
                CornerRadius="8"
                Clicked="OnUndoButtonClicked"/>
                    <Button x:Name="ClearButton"
                Text="Clear"
                BackgroundColor="#FF6347"
                TextColor="White"
                CornerRadius="8"
                Clicked="OnClearButtonClicked"/>
                    <Button x:Name="ApplyButton"
                Text="Apply Inpainting"
                BackgroundColor="#FF6347"
                TextColor="White"
                CornerRadius="8"
                 Clicked="OnApplyInpaintingClicked"/>
                </StackLayout>
            </Grid>
            

            <!-- Controls overlay - positioned at bottom and centered -->
            <Grid x:Name="ShapeDrawingCanvas" 
          IsVisible="False"
          InputTransparent="False"
          VerticalOptions="End"
          Margin="0,0,0,20">

                <StackLayout Orientation="Horizontal" 
                     Spacing="10"
                     HorizontalOptions="Center">
                    <Button Text="Rectangle" 
                   Clicked="OnRectangleButtonClicked"
                   BackgroundColor="#FF6347"
                   TextColor="White"
                   CornerRadius="5"
                   Padding="10,5"/>

                    <Button Text="Ellipse" 
                   Clicked="OnEllipseButtonClicked"
                   BackgroundColor="#FF6347"
                   TextColor="White"
                   CornerRadius="5"
                   Padding="10,5"/>

                    <Button Text="Triangle" 
                   Clicked="OnTriangleButtonClicked"
                   BackgroundColor="#FF6347"
                   TextColor="White"
                   CornerRadius="5"
                   Padding="10,5"/>

                    <Button Text="Change Color" 
                   Clicked="OnColorButtonClicked"
                   BackgroundColor="#FF6347"
                   TextColor="White"
                   CornerRadius="5"
                   Padding="10,5"/>

                    <Button Text="Undo" 
                   Clicked="OnUndoShapeButtonClicked"
                   BackgroundColor="#FF6347"
                   TextColor="White"
                   CornerRadius="5"
                   Padding="10,5"/>

                    <Button Text="Clear All" 
                   Clicked="OnClearShapesButtonClicked"
                   BackgroundColor="#FF6347"
                   TextColor="White"
                   CornerRadius="5"
                   Padding="10,5"/>

                    <Button Text="Done" 
                   Clicked="OnDoneDrawingButtonClicked"
                   BackgroundColor="#FF6347"
                   TextColor="White"
                   CornerRadius="5"
                   Padding="10,5"/>
                </StackLayout>
            </Grid>
        </Grid>

        <!-- Rest of your existing content remains the same -->
        <!-- Caption Editor Panel -->
        <Grid x:Name="CaptionEditorPanel" 
              Grid.Row="2" 
              IsVisible="False"
              RowDefinitions="Auto,Auto"
              Margin="10"
              BackgroundColor="#1a1a4d"
              Padding="10">
            <Entry x:Name="CaptionTextEntry" 
                   Placeholder="Enter caption text"
                   PlaceholderColor="Gray"
                   TextColor="White"
                   Grid.Row="0"
                   Margin="0,0,0,10"/>
            <StackLayout Orientation="Horizontal" 
                        Grid.Row="1" 
                        Spacing="10"
                        HorizontalOptions="Center">
                <Button x:Name="AddTextButton" 
                        Text="Add Text" 
                        BackgroundColor="#FF6347"
                        TextColor="White"
                        CornerRadius="8"
                        Clicked="OnAddTextButtonClicked"/>
                <Button x:Name="DoneCaptioningButton" 
                        Text="Done" 
                        BackgroundColor="#FF6347"
                        TextColor="White"
                        CornerRadius="8"
                        Clicked="OnDoneCaptioningClicked"/>
            </StackLayout>
        </Grid>

        <!-- Prompt Editor -->
        <Editor x:Name="PromptEditor" 
                Grid.Row="3" 
                Placeholder="Enter prompt to edit image" 
                PlaceholderColor="Gray"
                TextColor="White"
                FontFamily="Nunito-Bold"
                FontAttributes="Bold"
                BackgroundColor="#1a1a4d"
                AutoSize="TextChanges" 
                MaxLength="500"
                Margin="10"/>

        <!-- Edit Button -->
        <Button x:Name="EditButton" 
                Grid.Row="4" 
                Text="Edit"
                BackgroundColor="#FF6347"
                TextColor="White"
                ImageSource="edit_icon.png" 
                ContentLayout="Left,7"
                FontFamily="Nunito-Bold"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="8"
                Margin="10"/>

        <!-- Filter Buttons -->
        <Grid Grid.Row="5" x:Name="FilterContainer" HorizontalOptions="Center">
        <!-- Base Container -->
        <Frame BackgroundColor="White"
           CornerRadius="25"
           Padding="2"
           HasShadow="False"
           BorderColor="#8B5CF6"
           HeightRequest="50"
           WidthRequest="615"
           HorizontalOptions="Center"
           ZIndex="0">
        </Frame>

        <!-- Selection Indicator -->
        <Frame x:Name="SelectionIndicator"
           BackgroundColor="#FF6347"
           CornerRadius="23"
           HasShadow="False"
           IsClippedToBounds="True"
           HorizontalOptions="Start"
           WidthRequest="200"
           HeightRequest="46"
           Margin="2,2,2,2"
           ZIndex="1"/>

        <!-- Filter Buttons Grid -->
        <Grid ColumnDefinitions="200,200,200" 
          ColumnSpacing="0"
          ZIndex="2">
            <Frame x:Name="BlackAndWhiteFrame"
               Grid.Column="0" 
               BackgroundColor="Transparent"
               Padding="0"
               CornerRadius="23"
               HasShadow="False"
               BorderColor="Transparent"
               WidthRequest="100">
                <Label x:Name="BlackAndWhiteLabel"
                   Text="Black and White"
                   TextColor="#666666"
                   FontFamily="Nunito-Bold"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBlackAndWhiteTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Frame>

            <Frame x:Name="BlueShiftFrame"
               Grid.Column="1"
               BackgroundColor="Transparent"
               Padding="0"
               CornerRadius="23"
               HasShadow="False"
               BorderColor="Transparent"
               WidthRequest="100">
                <Label x:Name="BlueShiftLabel"
                   Text="Blue Shift"
                   TextColor="#666666"
                   FontFamily="Nunito-Bold"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBlueShiftTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Frame>

            <Frame x:Name="VintageFrame"
               Grid.Column="2"
               BackgroundColor="Transparent"
               Padding="0"
               CornerRadius="23"
               HasShadow="False"
               BorderColor="Transparent"
               WidthRequest="100">
                <Label x:Name="VintageLabel"
                   Text="Vintage"
                   TextColor="#666666"
                   FontFamily="Nunito-Bold"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVintageTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Frame>
        </Grid>
    </Grid>

    <!-- Save Button -->
        <Button x:Name="SaveButton" 
                Grid.Row="6" 
                Text="Save" 
                BackgroundColor="#FF6347"
                TextColor="White"
                ImageSource="save_icon.png" 
                ContentLayout="Left,7"
                FontFamily="Nunito-Bold"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="8"
                Margin="10"/>
        <Button x:Name="UploadButton" 
         Grid.Row="7" 
         Text="Upload" 
         BackgroundColor="#FF6347"
         TextColor="White"
         ImageSource="upload_icon.png" 
         ContentLayout="Left,7"
         FontFamily="Nunito-Bold"
         FontSize="16"
         FontAttributes="Bold"
         CornerRadius="8"
         Margin="10"/>
    </Grid>
</ContentPage>