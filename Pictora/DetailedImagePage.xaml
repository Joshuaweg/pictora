<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pictora.DetailedImagePage"
             Title="DetailedImagePage">
    <ScrollView>
        <VerticalStackLayout>
            <!-- WidthRequest needs to be looked at to see if a dynamic option can be done. -->
            <Image
            Source="pictoralogo.png"
            x:Name="Generated_Image"
            Aspect="AspectFit"
            WidthRequest="400"
            HorizontalOptions="Center"
            SemanticProperties.Description="dot net bot in a race car number eight" />


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>