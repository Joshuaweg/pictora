<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pictora.ImageGalleryPage"
             Title="Image Gallery">
    <VerticalStackLayout>
        <ScrollView>
            <!-- This is just for the sake of the demo, the actual grid will have to be generated by code, due to it being dynamic. -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" ColumnSpacing="10" RowSpacing="10" VerticalOptions="Start">
                <Image
                    Source="pictoralogo.png"
                    x:Name="Generated_Image_1"
                    HeightRequest="185"
                    Aspect="AspectFit"
                    Grid.Column = "0"
                    Grid.Row="0"
                    SemanticProperties.Description="dot net bot in a race car number eight"
                    />
                <Image
                    Source="pictoralogo.png"
                       x:Name="Generated_Image_2"
                    HeightRequest="185"
                    Aspect="AspectFit"
                    Grid.Column = "1"
                    Grid.Row="0"
                    SemanticProperties.Description="dot net bot in a race car number eight" />
                <Image
                    Source="pictoralogo.png"
                    x:Name="Generated_Image_3"
                    HeightRequest="185"
                    Aspect="AspectFit"
                    Grid.Column="2"
                    Grid.Row="0"
                    SemanticProperties.Description="dot net bot in a race car number eight" />
                <Image
                    Source="pictoralogo.png"
                    x:Name="Generated_Image_4"
                    HeightRequest="185"
                    Aspect="AspectFit"
                    Grid.Column = "0"
                    Grid.Row="1"
                    SemanticProperties.Description="dot net bot in a race car number eight"
                            />
                <Image
                    Source="pictoralogo.png"
                       x:Name="Generated_Image_5"
                    HeightRequest="185"
                    Aspect="AspectFit"
                    Grid.Column ="1"
                    Grid.Row = "1"
                    SemanticProperties.Description="dot net bot in a race car number eight" />
                <Image
                    Source="pictoralogo.png"
                       x:Name="Generated_Image_6"
                    HeightRequest="185"
                    Aspect="AspectFit"
                    Grid.Column="2"
                    Grid.Row = "1"
                    SemanticProperties.Description="dot net bot in a race car number eight" />
                <Image
                    Source="pictoralogo.png"
                    x:Name="Generated_Image_7"
                    HeightRequest="185"
                    Aspect="AspectFit"
                    Grid.Column = "0"
                    Grid.Row = "2"
                    SemanticProperties.Description="dot net bot in a race car number eight" />
                <Image
                    Source="pictoralogo.png"
                    x:Name="Generated_Image_8"
                    HeightRequest="185"
                    Aspect="AspectFit"
                    Grid.Column ="1"
                    Grid.Row = "2"
                    SemanticProperties.Description="dot net bot in a race car number eight" />
                <Image
                    Source="pictoralogo.png"
                       x:Name="Generated_Image_9"
                    HeightRequest="185"
                    Aspect="AspectFit"
                    Grid.Column="2"
                    Grid.Row = "2"
                    SemanticProperties.Description="dot net bot in a race car number eight" />
            </Grid>


        </ScrollView>
    </VerticalStackLayout>
</ContentPage>